# Environment secrets are intentionally NOT committed.
# Create a local file named:  environment .env
# (or copy values into a standard `.env`) with the following keys:

ETHERSCAN_API_KEY=your_etherscan_api_key_here
WHALE_THRESHOLD_USD=500000
POLL_INTERVAL_SECONDS=60

# Number of most-recent blocks to scan on each poll.
SCAN_BLOCK_WINDOW=20

# Ethereum mainnet chain id (1 = Ethereum Mainnet).
CHAIN_ID=1

# --- Incremental pipeline (feature/incremental-pipeline branch) ---------------
# The poller resumes from the last scanned block and only fetches *new* blocks.
# If the backlog exceeds this span (e.g. after being offline a while), the scan is
# capped to the newest SCAN_MAX_BLOCK_SPAN blocks to protect the free-tier budget.
SCAN_MAX_BLOCK_SPAN=2000