# Environment secrets are intentionally NOT committed.
# Create a local file named:  environment .env
# (or copy values into a standard `.env`) with the following keys:

ETHERSCAN_API_KEY=your_etherscan_api_key_here
WHALE_THRESHOLD_USD=10000000
POLL_INTERVAL_SECONDS=60

# Number of most-recent blocks to scan on each poll.
SCAN_BLOCK_WINDOW=80