# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# Environment secrets
.env
environment .env

# Secret API-key scratch files (must NOT be committed)
Etherscan_api.txt
deepseek_api.txt

# Runtime data
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# --- Incremental branch: commit the accumulating demo DB ----------------------
# The incremental branch ships data/whale_alert.db (historical data backfilled via
# backfill.py) so the 7d/30d time-series panels show something out of the box.
!data/whale_alert.db
# One-time bootstrap marker written by the container — never commit.
data/.bootstrap_backfilled

# Daily HTML reports (generated by scripts/daily_report.py)
reports/*.html

# OS / IDE
.DS_Store
.vscode/

# Generated demo artifacts (root-level screenshots are not committed)
/whale_dashboard*.png